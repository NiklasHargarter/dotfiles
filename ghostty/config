# Ghostty config.
# List builtin themes: `ghostty +list-themes`   Reload: cmd+shift+,

theme = TokyoNight

font-family = MesloLGS NF
font-size = 14

window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

background-opacity = 0.98
background-blur-radius = 20

# macOS Option key defaults to composing characters (ø, ∆, ¬) instead of sending
# an ESC prefix, so Alt-bindings never reach the remote: zellij's Alt+arrow pane
# focus and zsh's Alt+b / Alt+f word-jump both silently do nothing without this.
# Accepted (and ignored) by Ghostty on Linux, so it stays in the shared config.
macos-option-as-alt = true

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

copy-on-select = clipboard

# Shift+Enter → ESC + CR (some TUIs / Claude Code use this for newline)
keybind = shift+enter=text:\x1b\r

# SSH: remote servers lack the xterm-ghostty terminfo (breaks keys/colors/clear
# + zellij). Ghostty's shell integration fixes it automatically:
#   ssh-terminfo — installs Ghostty's terminfo on the remote (full features)
#   ssh-env      — falls back to TERM=xterm-256color when it can't
# (cursor,title are the defaults — re-listed since this replaces the set.)
shell-integration-features = cursor,title,ssh-env,ssh-terminfo

