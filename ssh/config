# Each managed Host block has a `# deploy: server|manual` marker on the line
# directly above it. `scripts/setup-ssh-keys.sh` reads this file as the source
# of truth and generates / deploys the key declared in IdentityFile.
#
#   server  — script will ssh-copy-id the pubkey to the Host alias
#   manual  — script will copy the pubkey to your clipboard so you can paste
#             it into a web UI (GitHub, GitLab, Forgejo, …)
#
# Hosts without a `# deploy:` marker are ignored by the script.

# --- GitHub ---
# deploy: manual
Host github.com

    User git
    IdentityFile ~/.ssh/id_ed25519_github

# --- Slifer ---
# deploy: server
Host slifer
    HostName 193.175.188.174
    User niklas
    IdentityFile ~/.ssh/id_ed25519_slifer

# --- Mimir ---
# deploy: server
Host mimir
    HostName 193.175.188.176
    User hargarter
    IdentityFile ~/.ssh/id_ed25519_mimir

# --- Optiplex ---
# deploy: server
Host optiplex
    HostName 192.168.1.33
    User optiplex
    IdentityFile ~/.ssh/id_ed25519_optiplex

# --- QIDI Plus 4 (printer) ---
# deploy: server
Host qidi
    HostName 192.168.1.156
    User mks
    IdentityFile ~/.ssh/id_ed25519_qidi

# --- HS-Flensburg HPC (Slurm) ---
# deploy: manual
Host hpc3
    HostName hpc3.hs-flensburg.de
    User hargarter
    IdentityFile ~/.ssh/id_ed25519_hpc3

# --- SDU GitLab ---
# deploy: manual
Host gitlab.sdu.dk
    HostName gitlab.sdu.dk
    User git
    IdentityFile ~/.ssh/id_ed25519_gitlab_sdu

# --- HS-Flensburg GitLab ---
# deploy: manual
Host gitlab.hs-flensburg.de
    HostName gitlab.hs-flensburg.de
    Port 2222
    User git
    IdentityFile ~/.ssh/id_ed25519_gitlab_hs-fl

# Keep keys in the agent after the first unlock; on macOS also remember the
# passphrase in Keychain. Ghostty's ssh wrapper opens two connections per ssh
# (terminfo install, then the session), so without this each one prompts.
Host *
    AddKeysToAgent yes
    IgnoreUnknown UseKeychain
    UseKeychain yes
